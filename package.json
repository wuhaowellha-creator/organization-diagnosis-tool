{
  "name": "hrbp-diagnosis-tool",
  "version": "1.0.0",
  "description": "A human-in-the-loop organization diagnosis workbench for HRBPs, with pluggable AI providers, follow-up workflows, and auditable reports.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Bighao (@wuhaowellha-creator)",
  "repository": {
    "type": "git",
    "url": "https://github.com/wuhaowellha-creator/organization-diagnosis-tool.git"
  },
  "bugs": {
    "url": "https://github.com/wuhaowellha-creator/organization-diagnosis-tool/issues"
  },
  "homepage": "https://github.com/wuhaowellha-creator/organization-diagnosis-tool#readme",
  "keywords": [
    "hrbp",
    "organization-diagnosis",
    "human-in-the-loop",
    "ai",
    "cloudflare-d1",
    "chatgpt-sites"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "openai": "^6.42.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
